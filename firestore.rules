rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User scope: Each commercial business owner has an isolated data silo
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Business Profile configuration
      match /profile/{profileDoc} {
        allow read, write: if isOwner(userId);
      }

      // Receipts & Invoices
      match /receipts/{receiptId} {
        allow read, write: if isOwner(userId) && isValidId(receiptId);
      }

      // Customers & Clients
      match /customers/{customerId} {
        allow read, write: if isOwner(userId) && isValidId(customerId);
      }

      // Line item presets & catalogue
      match /presets/{presetId} {
        allow read, write: if isOwner(userId) && isValidId(presetId);
      }
    }
  }
}
